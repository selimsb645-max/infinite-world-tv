# INFINITE WORLD TV — Phase 07 streaming secrets template.
#
# Copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# The real ".env" is covered by .gitignore and must NEVER be
# committed. Alternatively skip the file and export the variables
# in your shell / service manager — the environment wins over .env.
#
# NEVER paste a real stream key into this example file, into code,
# into a commit message, or into a chat/log you do not control.
# A stream key is a password: anyone who has it can stream to your
# channel. If one leaks, reset it in YouTube Studio immediately
# (Live Control Room -> stream key -> Reset).

# Your YouTube stream key (SECRET). Get it from YouTube Studio ->
# Go Live -> Stream tab. Shown once there; treat it like a password.
IWT_YOUTUBE_STREAM_KEY=PASTE_YOUR_STREAM_KEY_HERE

# Ingest base URL WITHOUT the key (the app appends the key itself).
# RTMPS is recommended by YouTube. Leave as-is unless you are
# testing against a local RTMP server (e.g. rtmp://127.0.0.1:1935/live).
IWT_RTMP_INGEST_URL=rtmps://a.rtmps.youtube.com/live2

# Stream visibility the automation will request: private | unlisted
# | public. Keep "private" for tests. Note: starting a PUBLIC
# broadcast additionally requires an explicit confirmation flag in
# the admin controls — this variable alone never makes a stream
# public.
IWT_STREAM_VISIBILITY=private

# Admin token (SECRET) authorizing start/stop/restart/log access
# in the streaming admin controls. Use a long random value.
IWT_ADMIN_TOKEN=PASTE_A_LONG_RANDOM_TOKEN_HERE
